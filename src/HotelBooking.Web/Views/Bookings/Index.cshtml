@model IReadOnlyList<BookingSummary>
@{
    ViewData["Title"] = "Мої бронювання";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Мої бронювання</h2>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary btn-sm">Підібрати номер</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Код</th>
                    <th>Готель</th>
                    <th>Номер</th>
                    <th>Період</th>
                    <th>Ночей</th>
                    <th>Вартість</th>
                    <th>Сплачено</th>
                    <th>Статус</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">Бронювань поки немає.</td></tr>
                }
                else
                {
                    foreach (var b in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@b.BookingCode</td>
                            <td>@b.HotelName <div class="small text-muted">@b.HotelCity</div></td>
                            <td>№@b.RoomNumber <div class="small text-muted">@b.CategoryName</div></td>
                            <td class="small">@b.CheckInDate.ToString("dd.MM.yyyy") — @b.CheckOutDate.ToString("dd.MM.yyyy")</td>
                            <td>@b.NightsCount</td>
                            <td>@b.TotalPrice.ToString("N2") грн</td>
                            <td>@b.PaidAmount.ToString("N2") грн</td>
                            <td><span class="badge status-badge status-@b.Status">@b.Status</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@b.BookingId" class="btn btn-outline-primary btn-sm">Відкрити</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>