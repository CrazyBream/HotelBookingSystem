@model AdminDashboardDto
@{
    ViewData["Title"] = "Панель керування";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h2 class="mb-0">Панель керування та аналітика</h2>
        <div class="text-muted small">Дані представлень <code>hotel.v_hotel_occupancy_stats</code> та журналу <code>hotel.booking_audit</code></div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Bookings" class="btn btn-primary btn-sm">Рецепція / Бронювання</a>
        @if (User.IsInRole("admin") || User.IsInRole("manager"))
        {
            <a asp-action="Hotels" class="btn btn-outline-primary btn-sm">Готелі та номери</a>
            <a asp-action="Guests" class="btn btn-outline-secondary btn-sm">Гості</a>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm stat-card">
            <div class="card-body">
                <div class="text-muted small">Зібрана виручка</div>
                <div class="fs-4 fw-bold text-success">@Model.TotalCollectedRevenue.ToString("N0") грн</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm stat-card">
            <div class="card-body">
                <div class="text-muted small">Очікувана виручка</div>
                <div class="fs-4 fw-bold text-primary">@Model.TotalExpectedRevenue.ToString("N0") грн</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm stat-card">
            <div class="card-body">
                <div class="text-muted small">Усього бронювань</div>
                <div class="fs-4 fw-bold">@Model.TotalBookings</div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card shadow-sm stat-card">
            <div class="card-body">
                <div class="text-muted small">Робочий номерний фонд</div>
                <div class="fs-4 fw-bold">@Model.TotalOperationalRooms</div>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-header bg-white fw-semibold">Статистика по готелях</div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Готель</th>
                    <th>Місто</th>
                    <th>Номери (роб./усього)</th>
                    <th>Бронювань</th>
                    <th>Підтв. / Заверш.</th>
                    <th>Скасовано</th>
                    <th>Сер. ночей</th>
                    <th>Очікувано</th>
                    <th>Сплачено</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.HotelStats)
                {
                    <tr>
                        <td>
                            <div class="fw-semibold">@s.HotelName</div>
                            <div class="small text-muted">@s.HotelCode · @(new string('★', s.StarRating))</div>
                        </td>
                        <td>@s.City</td>
                        <td>@s.OperationalRooms / @s.TotalRooms</td>
                        <td>@s.TotalBookings</td>
                        <td class="text-success fw-semibold">@s.ConfirmedBookings</td>
                        <td class="text-danger">@s.CancelledBookings</td>
                        <td>@s.AvgStayNights.ToString("0.##")</td>
                        <td>@s.ExpectedRevenue.ToString("N2") грн</td>
                        <td class="fw-bold text-success">@s.CollectedRevenue.ToString("N2") грн</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-white fw-semibold">Останні події аудиту статусів бронювань (AFTER-тригер)</div>
    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Бронювання</th>
                    <th>Перехід статусу</th>
                    <th>Користувач БД</th>
                    <th>Причина</th>
                    <th>Час</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model.RecentAudits)
                {
                    <tr>
                        <td class="text-muted small">@a.Id</td>
                        <td>
                            <a asp-controller="Bookings" asp-action="Details" asp-route-id="@a.BookingId" class="text-decoration-none fw-semibold">
                                #@a.BookingId
                            </a>
                        </td>
                        <td>
                            @if (string.IsNullOrEmpty(a.OldStatus))
                            {
                                <span class="text-muted">нове</span>
                            }
                            else
                            {
                                <span class="badge status-badge status-@a.OldStatus">@a.OldStatus</span>
                            }
                            <span class="mx-1">→</span>
                            <span class="badge status-badge status-@a.NewStatus">@a.NewStatus</span>
                        </td>
                        <td class="small"><code>@a.ChangedBy</code></td>
                        <td class="small">@a.Reason</td>
                        <td class="small text-muted">@a.ChangedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>