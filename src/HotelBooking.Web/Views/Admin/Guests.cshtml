@model IReadOnlyList<Guest>
@{
    ViewData["Title"] = "Керування гостями";
}

<h2 class="mb-4">Зареєстровані гості (@Model.Count)</h2>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>ПІБ</th>
                    <th>Email / Телефон</th>
                    <th>Документ</th>
                    <th>Реєстрація</th>
                    <th>Статус</th>
                    <th class="text-end">Дія</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var g in Model)
                {
                    <tr>
                        <td class="text-muted small">@g.Id</td>
                        <td class="fw-semibold">@g.FullName</td>
                        <td class="small">
                            <div>@g.Email</div>
                            <div class="text-muted">@g.Phone</div>
                        </td>
                        <td class="small">
                            @if (string.IsNullOrEmpty(g.DocumentType))
                            {
                                <span class="text-muted">Не вказано</span>
                            }
                            else
                            {
                                <span>@g.DocumentType: @g.DocumentNumber</span>
                            }
                        </td>
                        <td class="small text-muted">@g.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                        <td>
                            <span class="badge @(g.IsBanned ? "bg-danger" : "bg-success")">
                                @(g.IsBanned ? "Заблокований" : "Активний")
                            </span>
                        </td>
                        <td class="text-end">
                            <form asp-action="ToggleGuestBan" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@g.Id" />
                                <input type="hidden" name="isBanned" value="@(!g.IsBanned ? "true" : "false")" />
                                <button type="submit" class="btn btn-sm @(g.IsBanned ? "btn-outline-success" : "btn-outline-danger")">
                                    @(g.IsBanned ? "Розблокувати" : "Заблокувати")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>