@model IReadOnlyList<RoomCatalogItem>
@{
    ViewData["Title"] = "Каталог номерів";
    var cities = ViewBag.Cities as IReadOnlyList<string> ?? [];
    var selectedCity = ViewBag.SelectedCity as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <h2 class="mb-0">Каталог готельних номерів</h2>
    <form asp-action="Index" method="get" class="d-flex gap-2">
        <select name="city" class="form-select" style="min-width: 180px;">
            <option value="">Усі міста</option>
            @foreach (var c in cities)
            {
                <option value="@c" selected="@(selectedCity == c)">@c</option>
            }
        </select>
        <button type="submit" class="btn btn-primary">Фільтрувати</button>
    </form>
</div>

<div class="row g-4">
    @foreach (var room in Model)
    {
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm room-card">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge bg-secondary-subtle text-dark">@room.City · @(new string('★', room.StarRating))</span>
                        <span class="badge status-badge status-@room.RoomStatus">@room.RoomStatus</span>
                    </div>
                    <h5 class="card-title mb-1">
                        <a asp-action="Details" asp-route-id="@room.HotelId" class="text-decoration-none text-dark">@room.HotelName</a>
                    </h5>
                    <p class="text-muted small mb-2">Номер @room.RoomNumber (поверх @room.Floor) · @room.CategoryName</p>
                    <p class="small mb-2">@(room.RoomDescription ?? room.Address)</p>
                    <div class="small text-muted mb-3">До @room.MaxGuests гостей · @room.AreaSqm м²</div>

                    @if (room.Amenities.Length > 0)
                    {
                        <div class="d-flex flex-wrap gap-1 mb-3">
                            @foreach (var amenity in room.Amenities)
                            {
                                <span class="badge bg-light text-dark border">@amenity</span>
                            }
                        </div>
                    }

                    <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                        <span class="fw-bold fs-5 text-primary">@room.BasePrice.ToString("N0") грн <small class="text-muted fw-normal">/ ніч</small></span>
                        <a asp-action="Room" asp-route-id="@room.RoomId" class="btn btn-primary btn-sm">Детальніше</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>